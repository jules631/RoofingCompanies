# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# Company
COMPANY_NAME=Your Roofing Co
REP_PHONE_NUMBER=+15559876543

# Database (Supabase)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Redis (Upstash)
REDIS_URL=rediss://default:[password]@[hostname].upstash.io:6379

# Server
PORT=3001

# Frontend (set in Vercel env or .env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: restrict CORS to your frontend domain in production
FRONTEND_URL=https://your-app.vercel.app
